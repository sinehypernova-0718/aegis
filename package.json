{
  "name": "aegis",
  "private": true,
  "version": "0.1.0",
  "description": "Aegis is a local-first, encrypted vault for securely managing passwords, API keys, access tokens, SSH keys, and other sensitive credentials. Built with TypeScript, Vue, and PostgreSQL, it prioritizes strong cryptography, offline recovery, and user-controlled data in a premium, cinematic interface.",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "vault",
    "password-manager",
    "password-manager-app",
    "security"
  ],
  "homepage": "https://github.com/sinehypernova-0718/aegis#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/sinehypernova-0718/aegis.git"
  },
  "bugs": {
    "url": "https://github.com/sinehypernova-0718/aegis/issues"
  },
  "engines": {
    "node": ">=24.7.0",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "clean:build": "turbo run clean",
    "clean:nuke": "node scripts/nuke-workspace.mjs",
    "clean:nuke:dry": "node scripts/nuke-workspace.mjs --dry-run",
    "db:generate": "pnpm --filter @aegis/database db:generate",
    "db:migrate": "pnpm --filter @aegis/database db:migrate",
    "db:check": "pnpm --filter @aegis/database db:check",
    "db:studio": "pnpm --filter @aegis/database db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@changesets/cli": "3.0.2",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.2",
    "dotenv": "^18.0.9",
    "oxlint": "1.89.0",
    "rimraf": "6.1.3",
    "tsdown": "0.23.2",
    "tsx": "4.23.15",
    "turbo": "2.11.3",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
