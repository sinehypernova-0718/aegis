{
	"name": "@aegis/server",
	"version": "0.1.0",
	"private": true,
	"description": "Aegis Fastify API application.",
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"build": "tsc",
		"dev": "tsx watch src/index.ts",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"clean": "rimraf dist coverage",
		"format": "biome format .",
		"format:fix": "biome format . --write",
		"lint": "oxlint .",
		"lint:fix": "oxlint . --fix",
		"check": "biome check ."
	},
	"devDependencies": {
		"@aegis/crypto": "workspace:*",
		"@aegis/database": "workspace:*",
		"@aegis/domain": "workspace:*",
		"@types/node": "24.19.2",
		"drizzle-orm": "^0.45.4",
		"tsx": "4.23.15"
	}
}
